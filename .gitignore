# Godot 4+ specific ignores
# Godot 引擎本地缓存
.godot/

# 导出的可执行文件、构建目录
build/
export/
*.exe
*.apk
*.ipa
*.pck

# 系统临时文件
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# 临时/备份/日志文件
*.log
*.tmp
*.bak
~$*
crash.txt

# GDExtension 编译产物
*.so
*.dll
*.dylib

# 编辑器本地配置
.vscode/
.idea/
.memory/

/resources
/addons
/tasktool

# 官方文档
/0docs/godot-docs-html-stable